{
  "name": "dsh-xiaoyu-novel",
  "version": "3.12.3",
  "description": "小鱼创作台 —— DSH 网文创作辅助插件：主编 + 五帮手编排（大纲/写手/审校/设定/考据），逐章强制去 AI 味门禁，novel/ 结构化文件为数据库",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "xiaoyu-novel": "bin/xiaoyu-novel.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "pack": "node scripts/pack.mjs --tar",
    "pack:list": "node scripts/pack.mjs --list"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.7 <0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7 <0.3"
  },
  "dependencies": {},
  "files": [
    "index.mjs",
    "bin/",
    "lib/",
    "scripts/",
    "presets/",
    "skills/",
    "templates/",
    "docs/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "novel-writing",
    "web-novel",
    "orchestrator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gqpG10/dsh-xiaoyu-novel.git"
  },
  "dsh": {
    "privateRelease": true,
    "githubRepo": "gqpG10/dsh-xiaoyu-novel",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
